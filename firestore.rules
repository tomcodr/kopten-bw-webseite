rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /gallery/{imageId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.keys().hasOnly(['title','url','storagePath','createdAt','createdBy']) && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /contactMessages/{messageId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
